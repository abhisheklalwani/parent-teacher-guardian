# Python backend base URL (server-only; used by lib/backend.ts)
PYTHON_BACKEND_URL=http://localhost:3001

# Resend (server-only; used by app/api/outreach/send/route.ts)
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified sender on your Resend account/domain
RESEND_FROM_EMAIL=
# Demo/testing only: when set, every outreach send is redirected to this
# inbox instead of the (synthetic) guardian address, so demos never depend
# on real deliverable parent emails. Leave unset to send to guardianEmail.
RESEND_TEST_RECIPIENT_EMAIL=
