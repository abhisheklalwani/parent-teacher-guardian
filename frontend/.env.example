# Python backend base URL (server-only; used by lib/backend.ts)
PYTHON_BACKEND_URL=http://localhost:3001

# Resend (server-only; used by lib/email.ts, shared by outreach/send and syllabus/send)
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified sender on your Resend account/domain
RESEND_FROM_EMAIL=
# Demo/testing only: when set, every send (outreach or syllabus) is redirected
# to this inbox instead of the (synthetic) guardian address, so demos never
# depend on real deliverable parent emails. Leave unset to send to guardianEmail.
RESEND_TEST_RECIPIENT_EMAIL=
